{
    "openapi": "3.0.0",
    "info": {
        "title": "Financial Data API",
        "description": "API for handling file uploads",
        "version": "1.0.0"
    },
    "paths": {
        "/api/assets": {
            "get": {
                "tags": [
                    "Assets"
                ],
                "summary": "List all assets",
                "description": "Returns paginated list of assets",
                "operationId": "getAssets",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 1
                        }
                    },
                    {
                        "name": "TckrSymb",
                        "in": "query",
                        "description": "Ticker symbol",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": "AAPL"
                        }
                    },
                    {
                        "name": "RptDt",
                        "in": "query",
                        "description": "Report date",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": "2021-01-01"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "example": 1
                                                    },
                                                    "name": {
                                                        "type": "string",
                                                        "example": "Asset name"
                                                    },
                                                    "description": {
                                                        "type": "string",
                                                        "example": "Asset description"
                                                    },
                                                    "created_at": {
                                                        "type": "string",
                                                        "format": "date-time"
                                                    },
                                                    "updated_at": {
                                                        "type": "string",
                                                        "format": "date-time"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        },
                                        "meta": {
                                            "properties": {
                                                "current_page": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "total": {
                                                    "type": "integer",
                                                    "example": 30
                                                },
                                                "per_page": {
                                                    "type": "integer",
                                                    "example": 15
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Internal server error"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/upload": {
            "post": {
                "tags": [
                    "File"
                ],
                "summary": "Upload a file",
                "operationId": "b4116c9c1cbcf1030ec056ee6176a3dc",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "properties": {
                                    "file": {
                                        "description": "File to upload",
                                        "type": "string",
                                        "format": "binary"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "File uploaded successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "File uploaded successfully"
                                        },
                                        "path": {
                                            "type": "string",
                                            "example": "/storage/uploads/file.txt"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "The file field is required"
                                        },
                                        "errors": {
                                            "type": "object",
                                            "example": {
                                                "file": [
                                                    "The file field is required"
                                                ]
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/files": {
            "get": {
                "tags": [
                    "File"
                ],
                "summary": "Get list of all files",
                "description": "Returns a list of all uploaded files",
                "operationId": "getFiles",
                "parameters": [
                    {
                        "name": "name",
                        "in": "query",
                        "description": "Filter files by name",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "created_at",
                        "in": "query",
                        "description": "Filter files by creation date",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "date-time"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "files": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "example": 1
                                                    },
                                                    "name": {
                                                        "type": "string",
                                                        "example": "document.pdf"
                                                    },
                                                    "path": {
                                                        "type": "string",
                                                        "example": "/storage/uploads/document.pdf"
                                                    },
                                                    "created_at": {
                                                        "type": "string",
                                                        "format": "date-time"
                                                    },
                                                    "updated_at": {
                                                        "type": "string",
                                                        "format": "date-time"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "Assets",
            "description": "Assets"
        },
        {
            "name": "File",
            "description": "File"
        }
    ]
}